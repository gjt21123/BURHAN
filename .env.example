# No credentials are needed for deterministic tests, fixtures or the demo.
# For the Next.js UI, copy this template to apps/web/.env.local, not the root.
# Live compilation is disabled by default. Enable only after reviewing the task.
BURHAN_ENABLE_LIVE_COMPILER=0
OPENAI_API_KEY=

# Codex uses the local CLI authentication state; never copy it into a workspace.
# CODEX_HOME is optional and must reference only your own local configuration.
# CODEX_HOME=
